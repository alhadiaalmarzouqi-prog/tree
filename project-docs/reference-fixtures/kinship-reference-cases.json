    "people": "Each person has id, father_id, mother_id. null = unrecorded parent in this closed fixture.",
    "path": "nodes = ordered ids from the queried person to the ancestor. roles = parent role of each edge in order. length = number of edges. Identity path has length 0.",
    "valid_path_pair": "Two paths from person_a and person_b to the same ancestor whose vertex sets intersect in exactly that ancestor.",
    "valid_junction_ancestors": "J: ancestors with at least one valid path pair.",
    "valid_path_pair_count": "R: number of valid path pairs. Not a count of independent human relationships.",
    "ab": "a = length(path_a), b = length(path_b), L = a + b.",
    "structural_classification": "Conservative structural label only. Terminology is pending (DR-16, KD-01, KD-02)."
  },
